# Solana mainnet RPC endpoint (server-side). Required.
# Used to read on-chain positions from Kamino, Save, Drift, and JupLend.
# Get a free mainnet URL at https://helius.dev
RPC_URL=

# Helius API key (server-side). Required.
# Used to fetch wallet transaction history. https://helius.dev
HELIUS_API_KEY=

# Client-side RPC for the wallet adapter. Optional.
# Defaults to the public mainnet-beta endpoint (rate-limited) if unset.
NEXT_PUBLIC_SOLANA_RPC_URL=

# Base URL for the app's API routes. Optional.
# Leave empty for local development (same-origin requests).
NEXT_PUBLIC_API_BASE_URL=
